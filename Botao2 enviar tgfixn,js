// =====================================================================
// BOTAO 2 -- "Enviar para TGFIXN"
// Acao Script na tela AD_XMLFULL
//
// Le a fila e grava na TGFIXN com STATUS = 0, para o motor processar.
//
// Se houver linhas SELECIONADAS na grade, processa somente elas.
// Se nada estiver selecionado, processa as Pendentes por ordem de chegada.
//
// Cada linha e isolada: erro em uma nao impede as outras.
// =====================================================================

// ---------------------------------------------------------- CONFIGURACAO
var LIMITE_LOTE  = 20;    // linhas processadas por clique
var MAX_TENTATIVAS = 3;   // desiste depois disso (evita loop infinito)

var CODEMP_FIXO = 1;      // unico CNPJ emitente no Full (28414558000132)
var CODUSU_IMP  = 0;

// =====================================================================
// Atualiza a linha da fila.
//
// ATENCAO -- PONTO A VALIDAR NESTA INSTALACAO:
// 'nativeSelect' serve para SELECT. Para UPDATE, o metodo varia entre
// versoes do Sankhya (nativeUpdate, executeUpdate, executeNative...).
// Esta funcao tenta em cadeia e, se nenhum existir, usa o objeto de
// linha quando a linha esta selecionada na grade.
//
// Rode a SONDA (ver README do Plano B) para descobrir o nome certo e
// deixar so ele aqui.
// =====================================================================
function atualizaFila(nufila, situacao, nuarquivo, msg) {
    var texto = String(msg == null ? "" : msg).replace(/'/g, "");

    var sql = "UPDATE AD_XMLFULL SET SITUACAO = '" + situacao + "'"
            + ", DHTRANSFERIDO = SYSDATE"
            + ", TENTATIVAS = TENTATIVAS + 1"
            + (nuarquivo != null ? ", NUARQUIVO = " + nuarquivo : "")
            + ", MENSAGEM = '" + texto + "'"
            + " WHERE NUFILA = " + nufila;

    var q = getQuery("native");

    // tentativa 1
    try { q.nativeUpdate(sql); return; } catch (e1) { }
    // tentativa 2
    try { q.executeUpdate(sql); return; } catch (e2) { }
    // tentativa 3
    try { q.executeNative(sql); return; } catch (e3) { }

    // fallback: se a linha esta selecionada na grade, grava pelo objeto
    try {
        if (linhas != null) {
            for (var L = 0; L < linhas.length; L++) {
                if (Number(linhas[L].getCampo('NUFILA')) === Number(nufila)) {
                    linhas[L].setCampo('SITUACAO', situacao);
                    linhas[L].setCampo('DHTRANSFERIDO', new Date());
                    linhas[L].setCampo('MENSAGEM', texto.substring(0, 500));
                    if (nuarquivo != null) linhas[L].setCampo('NUARQUIVO', nuarquivo);
                    linhas[L].save();
                    return;
                }
            }
        }
    } catch (e4) { }

    throw "nao foi possivel atualizar a fila (NUFILA " + nufila + ")";
}

// ------------------------------------------------------------ UTILITARIOS
function extrai(texto, tag) {
    var abre = "<" + tag + ">", fecha = "</" + tag + ">";
    var ini = texto.indexOf(abre);
    if (ini < 0) return null;
    ini += abre.length;
    var fim = texto.indexOf(fecha, ini);
    return (fim < 0) ? null : texto.substring(ini, fim);
}
function bloco(texto, tag) {
    var abre = "<" + tag + ">", fecha = "</" + tag + ">";
    var ini = texto.indexOf(abre);
    if (ini < 0) return "";
    var fim = texto.indexOf(fecha, ini);
    return (fim < 0) ? "" : texto.substring(ini, fim + fecha.length);
}
function docDoBloco(b) {
    var d = extrai(b, "CNPJ");
    if (d == null) d = extrai(b, "CPF");
    return d;
}
function corta(txt, max) {
    if (txt == null) return null;
    txt = String(txt);
    return (txt.length > max) ? txt.substring(0, max) : txt;
}
function dataDe(txt) {
    if (txt == null || txt.length < 19) return null;
    return new Date(
        Number(txt.substring(0, 4)), Number(txt.substring(5, 7)) - 1,
        Number(txt.substring(8, 10)), Number(txt.substring(11, 13)),
        Number(txt.substring(14, 16)), Number(txt.substring(17, 19)));
}
function serieDaChave(ch)  { return Number(ch.substring(22, 25)); }
function numeroDaChave(ch) { return Number(ch.substring(25, 34)); }

// TIPONFE espelha o tpNF em 100% das 121 notas que processaram (STATUS 5):
//   tpNF 0 (entrada / devolucao) -> 'E'    tpNF 1 (saida / venda) -> 'V'
function tipoNfeDe(tpNF) {
    return (String(tpNF) === "1") ? "V" : "E";
}

// Baixa o XML do S3 (fallback, se a leitura do CLOB nao funcionar)
function baixaDoS3(endereco) {
    var url = new java.net.URL(String(endereco));
    var conn = url.openConnection();
    conn.setConnectTimeout(15000);
    conn.setReadTimeout(30000);
    var codigo = conn.getResponseCode();
    var stream = (codigo >= 400) ? conn.getErrorStream() : conn.getInputStream();
    if (stream == null) throw "HTTP " + codigo + " sem corpo";
    var sc = new java.util.Scanner(stream, "UTF-8").useDelimiter("\\A");
    var txt = sc.hasNext() ? sc.next() : "";
    sc.close();
    if (codigo >= 400) throw "HTTP " + codigo;
    return String(txt);
}

// Le o XML da fila. Se o CLOB vier vazio ou truncado, rebaixa do S3.
// A URL fica guardada justamente para isso.
function pegaXml(nufila) {
    var q = getQuery("native");
    q.setParam("nu", nufila);
    q.nativeSelect("SELECT XML, URLORIGEM FROM AD_XMLFULL WHERE NUFILA = {nu}");
    if (!q.next()) throw "linha " + nufila + " nao encontrada na fila";

    var xml = null;
    try { xml = q.getString("XML"); } catch (e) { xml = null; }

    // Um XML de NF-e sempre fecha com </nfeProc> ou </NFe>.
    // Se nao fechar, o CLOB veio incompleto -> rebaixa.
    var ok = (xml != null) && (String(xml).indexOf("</") > 0)
             && (String(xml).length > 500);

    if (!ok) {
        var url = q.getString("URLORIGEM");
        if (url == null || String(url) === "") {
            throw "XML ilegivel na fila e sem URLORIGEM para rebaixar";
        }
        xml = baixaDoS3(url);
    }
    return String(xml);
}

// ============================================================ ETAPA 1
// Monta a lista de NUFILA a processar.
var alvos = [];
var origemSelecao = false;

// 1a) linhas selecionadas na grade?
try {
    if (linhas != null && linhas.length > 0) {
        for (var L = 0; L < linhas.length; L++) {
            alvos.push(Number(linhas[L].getCampo('NUFILA')));
        }
        origemSelecao = true;
    }
} catch (eSel) {
    origemSelecao = false;
}

// 1b) senao, as pendentes por ordem de chegada
if (alvos.length === 0) {
    var qPend = getQuery("native");
    qPend.setParam("lim", LIMITE_LOTE);
    qPend.setParam("tent", MAX_TENTATIVAS);
    qPend.nativeSelect(
        "SELECT NUFILA FROM ("
      + "  SELECT NUFILA FROM AD_XMLFULL"
      + "  WHERE SITUACAO IN ('P','E') AND TENTATIVAS < {tent}"
      + "  ORDER BY NUFILA"
      + ") WHERE ROWNUM <= {lim}");
    while (qPend.next()) {
        alvos.push(Number(qPend.getString("NUFILA")));
    }
}

if (alvos.length === 0) {
    mensagem = "Nada a enviar: nenhuma linha selecionada e nenhuma pendente na fila.";
} else {

// ============================================================ ETAPA 2
// Processa uma por uma, isoladas.
var enviadas = 0, duplicadas = 0, falhas = 0, puladas = 0;
var erros = "";

for (var a = 0; a < alvos.length && enviadas < LIMITE_LOTE; a++) {
    var nufila = alvos[a];

    try {
        // --- estado atual da linha
        var qL = getQuery("native");
        qL.setParam("nu", nufila);
        qL.nativeSelect("SELECT SITUACAO, TENTATIVAS, CHAVEACESSO, TIPODOC, IDARQUIVO"
                      + " FROM AD_XMLFULL WHERE NUFILA = {nu}");
        if (!qL.next()) throw "linha nao encontrada";

        var sit    = String(qL.getString("SITUACAO"));
        var tent   = Number(qL.getString("TENTATIVAS"));
        var chave  = qL.getString("CHAVEACESSO");
        var tipo   = qL.getString("TIPODOC");
        var idArq  = qL.getString("IDARQUIVO");

        // ja transferida ou duplicada -> nao mexe
        if (sit === 'T' || sit === 'D') { puladas++; continue; }
        if (tent >= MAX_TENTATIVAS)     { puladas++; continue; }

        // --- DEDUP: a chave ja existe na TGFIXN?
        var dup = getQuery("native");
        dup.setParam("ch", String(chave));
        dup.nativeSelect("SELECT COUNT(*) AS QTD FROM TGFIXN WHERE CHAVEACESSO = {ch}");
        dup.next();

        if (Number(dup.getString("QTD")) > 0) {
            atualizaFila(nufila, 'D', null, "Chave ja existia na TGFIXN");
            duplicadas++;
            continue;
        }

        // --- le o XML (com fallback de rebaixar do S3)
        var xml = pegaXml(nufila);

        var bEmit = bloco(xml, "emit");
        var bDest = bloco(xml, "dest");
        var nomeEmit = extrai(bEmit, "xNome");
        var nomeDest = extrai(bDest, "xNome");
        var docEmit  = docDoBloco(bEmit);
        var docDest  = docDoBloco(bDest);

        var natOp    = extrai(xml, "natOp");
        var cfop     = extrai(xml, "CFOP");
        var tpNF     = extrai(xml, "tpNF");
        var vNF      = extrai(xml, "vNF");
        var dhEmi    = extrai(xml, "dhEmi");
        var dhRecbto = extrai(xml, "dhRecbto");
        var refNFe   = extrai(xml, "refNFe");

        var chaveXml = extrai(xml, "chNFe");
        if (chaveXml == null || chaveXml.length !== 44) throw "chNFe invalida no XML";

        // Parceiro = o lado que NAO e a BeBaby (CNPJ sai da propria chave)
        var cnpjBebaby = chaveXml.substring(6, 20);
        var docParc = (docEmit != null && String(docEmit) === cnpjBebaby)
                    ? docDest : docEmit;
        if (docParc == null) docParc = docDest;

        // --- grava na TGFIXN
        var nova = novaLinha('TGFIXN');

        nova.setCampo('XML', xml);
        nova.setCampo('CHAVEACESSO', chaveXml);
        nova.setCampo('NOMEARQUIVO', corta('INVOICE-' + tipo + '-' + idArq + '.XML', 200));
        nova.setCampo('TIPO', 'N');
        nova.setCampo('STATUS', 0);
        nova.setCampo('CODEMP', CODEMP_FIXO);
        nova.setCampo('DHIMPORT', new Date());
        nova.setCampo('CODUSUIMP', CODUSU_IMP);
        nova.setCampo('TIPONFE', tipoNfeDe(tpNF));

        nova.setCampo('NUMNOTA', numeroDaChave(chaveXml));
        nova.setCampo('SERIEDOC', serieDaChave(chaveXml));

        // CODTIPOPER NAO se envia: o motor deduz a TOP pelo modelo do XML
        if (natOp != null) nova.setCampo('NATUREZAOPER', natOp);
        if (cfop  != null) nova.setCampo('CFOPXML', cfop);
        if (tpNF  != null) nova.setCampo('ENTSAINFE', String(tpNF));   // VARCHAR2(1)

        if (vNF      != null) nova.setCampo('VLRNOTA', Number(vNF));
        if (dhEmi    != null) nova.setCampo('DHEMISS', dataDe(dhEmi));
        if (dhRecbto != null) nova.setCampo('DTAUTORIZACAO', dataDe(dhRecbto));

        // CODPARC nao se seta: o motor localiza e, se nao existir, cadastra
        if (nomeEmit != null) nova.setCampo('XNOMEEMIT', corta(nomeEmit, 60));
        if (nomeDest != null) nova.setCampo('XNOMEDEST', corta(nomeDest, 60));
        if (docDest  != null) nova.setCampo('CNPJDEST', corta(docDest, 14));
        if (docParc  != null) nova.setCampo('CNPJPARC', corta(docParc, 14));

        if (refNFe != null) {
            nova.setCampo('DOCSREF',
                '<docsRef><chaveAcesso>' + refNFe + '</chaveAcesso></docsRef>');
        }

        nova.save();

        // --- recupera o NUARQUIVO gerado, pela chave
        var nuArq = null;
        var qNu = getQuery("native");
        qNu.setParam("ch", chaveXml);
        qNu.nativeSelect("SELECT MAX(NUARQUIVO) AS NU FROM TGFIXN WHERE CHAVEACESSO = {ch}");
        if (qNu.next()) nuArq = Number(qNu.getString("NU"));

        atualizaFila(nufila, 'T', nuArq, "Enviado para a TGFIXN");
        enviadas++;

    } catch (e) {
        falhas++;
        try { atualizaFila(nufila, 'E', null, corta("" + e, 500)); } catch (e2) { }
        if (erros.length < 400) erros += "[fila " + nufila + "] " + e + " ;; ";
    }
}

// ============================================================ RESUMO
// IMPORTANTE: 'mensagem', NUNCA 'throw'.
mensagem = enviadas + " nota(s) enviada(s) para a TGFIXN."
    + (duplicadas > 0 ? "  |  " + duplicadas + " ja existia(m) (marcada[s] como Duplicado)." : "")
    + (puladas    > 0 ? "  |  " + puladas + " pulada(s)." : "")
    + (falhas     > 0 ? "  |  " + falhas + " erro(s): " + erros : "")
    + (origemSelecao ? "  ||  (linhas selecionadas)" : "  ||  (pendentes da fila)");

}  // fim do else
