// =====================================================================
// BOTAO 1 -- "Buscar na Anymarket"
// Acao Script na tela AD_XMLFULL
//
// Traz os documentos novos da Anymarket para a fila, com SITUACAO = 'P'.
// NAO toca na TGFIXN.
//
// Dedup por IDARQUIVO (nome do arquivo na URL do S3), aplicado ANTES do
// download -- documento ja conhecido nao gera requisicao ao S3.
// =====================================================================

// ---------------------------------------------------------- CONFIGURACAO
var PARAM_TOKEN    = "ANYMARKET_TOKEN";
var TOKEN_FALLBACK = "";      // cole o token aqui SO para testar

var LIMITE_LOTE = 1;          // UMA nota por clique (fase de teste)
var MAX_PAGINAS = 30;
var PAGE_SIZE   = 50;         // minimo aceito pela API e 5
var FILA_FOLGA  = 5;          // margem de candidatas, ja que algumas podem falhar

// Tipos habilitados. Descomente conforme validar.
var TIPOS = {
    "devolution":              true,
    "sale_return":             true
    // "inbound":                 true,   // 13 docs
    // "inbound_return":          true,   // 11 docs
    // "symbolic_inbound":        true,   // 32 docs
    // "symbolic_inbound_return": true,   // 522 docs
    // "sale":                    true    // 476 docs - EXIGE AVAL DE PROCESSO
};

var BASE = "https://api.anymarket.com.br/v2/fulfillment/MERCADO_LIVRE/documents";

// ---------------------------------------------------------------- TOKEN
function pegaToken() {
    try {
        var t = getParametroSistema(PARAM_TOKEN);
        if (t != null && String(t) !== "") return String(t);
    } catch (e) { }
    if (TOKEN_FALLBACK !== "") return TOKEN_FALLBACK;
    throw "Token da Anymarket nao configurado. Crie o parametro " + PARAM_TOKEN + ".";
}
var token = pegaToken();

// ----------------------------------------------------------------- HTTP
// getErrorStream e essencial: sem ele a mensagem de erro da API se perde.
function baixa(endereco, comToken) {
    var url = new java.net.URL(endereco);
    var conn = url.openConnection();
    if (comToken) conn.setRequestProperty("gumgaToken", token);
    conn.setConnectTimeout(15000);
    conn.setReadTimeout(30000);

    var codigo = conn.getResponseCode();
    var stream = (codigo >= 400) ? conn.getErrorStream() : conn.getInputStream();
    if (stream == null) throw "HTTP " + codigo + " sem corpo";

    var sc = new java.util.Scanner(stream, "UTF-8").useDelimiter("\\A");
    var txt = sc.hasNext() ? sc.next() : "";
    sc.close();

    if (codigo >= 400) throw "HTTP " + codigo + ": " + String(txt);
    return String(txt);
}

// ------------------------------------------------------------ UTILITARIOS
// .../transactionType-devolution/259061706.6606158899.xml
//                                259061706.6606158899
function arquivoDaUrl(u) {
    var s = String(u);
    var nome = s.substring(s.lastIndexOf("/") + 1);
    var ponto = nome.lastIndexOf(".xml");
    return (ponto < 0) ? nome : nome.substring(0, ponto);
}
function extrai(texto, tag) {
    var abre = "<" + tag + ">", fecha = "</" + tag + ">";
    var ini = texto.indexOf(abre);
    if (ini < 0) return null;
    ini += abre.length;
    var fim = texto.indexOf(fecha, ini);
    return (fim < 0) ? null : texto.substring(ini, fim);
}
function bloco(texto, tag) {
    var abre = "<" + tag + ">", fecha = "</" + tag + ">";
    var ini = texto.indexOf(abre);
    if (ini < 0) return "";
    var fim = texto.indexOf(fecha, ini);
    return (fim < 0) ? "" : texto.substring(ini, fim + fecha.length);
}
function docDoBloco(b) {
    var d = extrai(b, "CNPJ");
    if (d == null) d = extrai(b, "CPF");
    return d;
}
function corta(txt, max) {
    if (txt == null) return null;
    txt = String(txt);
    return (txt.length > max) ? txt.substring(0, max) : txt;
}
function dataDe(txt) {
    if (txt == null || txt.length < 19) return null;
    return new Date(
        Number(txt.substring(0, 4)), Number(txt.substring(5, 7)) - 1,
        Number(txt.substring(8, 10)), Number(txt.substring(11, 13)),
        Number(txt.substring(14, 16)), Number(txt.substring(17, 19)));
}
function serieDaChave(ch)  { return Number(ch.substring(22, 25)); }
function numeroDaChave(ch) { return Number(ch.substring(25, 34)); }

// ============================================================ ETAPA 1
// Carrega os IDARQUIVO ja na fila. Uma query, nao N.
var naFila = {};
var qtdFila = 0;
var qFila = getQuery("native");
qFila.nativeSelect("SELECT IDARQUIVO FROM AD_XMLFULL");
while (qFila.next()) {
    naFila[String(qFila.getString("IDARQUIVO"))] = true;
    qtdFila++;
}

// ============================================================ ETAPA 2
// Varre a listagem. NENHUM download acontece aqui.
var FILA_MAX = LIMITE_LOTE * FILA_FOLGA;
var candidatas = [];
var paginas = 0, vistos = 0, outrosTipos = 0, jaNaFila = 0;

while (paginas < MAX_PAGINAS && candidatas.length < FILA_MAX) {
    var dados = JSON.parse(baixa(
        BASE + "?limit=" + PAGE_SIZE + "&offset=" + (paginas * PAGE_SIZE), true));
    var lista = dados.content;
    if (lista == null || lista.length === 0) break;

    for (var i = 0; i < lista.length; i++) {
        vistos++;
        var doc = lista[i];

        if (TIPOS[doc.type] !== true) { outrosTipos++; continue; }

        var idArq = arquivoDaUrl(doc.url);
        if (naFila[idArq] === true) { jaNaFila++; continue; }

        naFila[idArq] = true;   // nao repete na propria rodada
        candidatas.push({ doc: doc, id: idArq });
        if (candidatas.length >= FILA_MAX) break;
    }

    var temNext = false;
    if (dados.links != null) {
        for (var j = 0; j < dados.links.length; j++) {
            if (dados.links[j].rel === "next") temNext = true;
        }
    }
    if (!temNext) break;
    paginas++;
}

// ============================================================ ETAPA 3
// Baixa o XML, extrai os campos legiveis, e enfileira.
var enfileiradas = 0, falhas = 0;
var erros = "";
var detalhe = "";

for (var f = 0; f < candidatas.length && enfileiradas < LIMITE_LOTE; f++) {
    var item = candidatas[f];
    try {
        var xml = baixa(item.doc.url, false);   // S3 e publico: SEM token

        var chave = extrai(xml, "chNFe");
        if (chave == null || chave.length !== 44) throw "chNFe ausente ou invalida";

        var bEmit = bloco(xml, "emit");
        var bDest = bloco(xml, "dest");
        var docEmit = docDoBloco(bEmit);
        var docDest = docDoBloco(bDest);

        // Parceiro = o lado que NAO e a BeBaby. O CNPJ dela sai da chave.
        var cnpjBebaby = chave.substring(6, 20);
        var docParc = (docEmit != null && String(docEmit) === cnpjBebaby)
                    ? docDest : docEmit;
        if (docParc == null) docParc = docDest;

        // Quem e o "cliente" para a Denise ler: o lado que nao e a BeBaby.
        var nomeCliente = (docEmit != null && String(docEmit) === cnpjBebaby)
                        ? extrai(bDest, "xNome") : extrai(bEmit, "xNome");
        if (nomeCliente == null) nomeCliente = extrai(bDest, "xNome");

        var natOp = extrai(xml, "natOp");
        var vNF   = extrai(xml, "vNF");
        var dhEmi = extrai(xml, "dhEmi");

        var nova = novaLinha('AD_XMLFULL');
        nova.setCampo('SITUACAO',     'P');
        nova.setCampo('DHRECEBIDO',   new Date());
        nova.setCampo('IDARQUIVO',    corta(item.id, 60));
        nova.setCampo('TIPODOC',      corta(item.doc.type, 40));
        nova.setCampo('URLORIGEM',    corta(item.doc.url, 500));
        nova.setCampo('XML',          xml);
        nova.setCampo('CHAVEACESSO',  corta(chave, 44));
        nova.setCampo('NUMNOTA',      numeroDaChave(chave));
        nova.setCampo('SERIEDOC',     serieDaChave(chave));
        nova.setCampo('TENTATIVAS',   0);

        if (item.doc.subType != null) {
            nova.setCampo('SUBTIPODOC', corta(item.doc.subType, 40));
        }
        if (nomeCliente != null) nova.setCampo('NOMECLIENTE', corta(nomeCliente, 60));
        if (docParc     != null) nova.setCampo('CNPJPARC', corta(docParc, 14));
        if (natOp       != null) nova.setCampo('NATUREZAOPER', corta(natOp, 60));
        if (vNF         != null) nova.setCampo('VLRNOTA', Number(vNF));
        if (dhEmi       != null) nova.setCampo('DHEMISS', dataDe(dhEmi));

        nova.save();
        enfileiradas++;

        // resumo da nota trazida, para conferir sem abrir a grade
        detalhe = item.doc.type
                + " | NF " + serieDaChave(chave) + "/" + numeroDaChave(chave)
                + " | R$ " + vNF
                + " | " + (nomeCliente == null ? "?" : corta(nomeCliente, 28))
                + " | emissao " + corta(dhEmi, 10);

    } catch (e) {
        falhas++;
        if (erros.length < 500) erros += "[" + corta(item.id, 25) + "] " + e + " ;; ";
    }
}

// ============================================================ RESUMO
// IMPORTANTE: 'mensagem', NUNCA 'throw'.
// throw faz rollback e apagaria tudo que acabou de ser gravado.
if (enfileiradas === 0 && falhas === 0) {
    mensagem = "Nenhuma nota nova encontrada."
             + " Tudo o que existe na Anymarket para os tipos habilitados"
             + " ja esta na fila (" + qtdFila + " registro[s])."
             + "  ||  Documentos verificados: " + vistos + ".";
} else {
    mensagem = enfileiradas + " nota trazida para a fila (Pendente)."
             + (detalhe === "" ? "" : "  ||  " + detalhe)
             + (falhas > 0 ? "  ||  " + falhas + " falha(s): " + erros : "")
             + "  ||  (fila antes: " + qtdFila
             + " | verificados: " + vistos
             + " | outros tipos: " + outrosTipos
             + " | ja tinha: " + jaNaFila + ")";
}
